# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
# 测试临时目录放项目内：系统 temp 里攒够 50 个文件会被沙箱的安全删除策略拦下，
# 表现是"测试全绿但退出码 1"（很容易被误读成失败）
.pytest-tmp/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/
env/

# 本地数据（数据库/日志/演示库）—— 账目事实不进版本库
data/
*.db
*.db-shm
*.db-wal
*.log

# 节点容器的本地配置（含 A2N_STORAGE_KEY）—— 模板是 docker/.env.example
docker/.env
.env

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# Node（SDK 前端若有）
node_modules/
.tmp/
